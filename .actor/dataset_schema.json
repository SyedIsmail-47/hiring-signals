{
    "actorSpecification": 1,
    "title": "Hiring signals",
    "description": "One record per company checked in this run.",
    "fields": {
        "type": "object",
        "properties": {
            "name": {
                "type": "string",
                "title": "Company",
                "description": "Company name from the input."
            },
            "domain": {
                "type": "string",
                "title": "Domain",
                "description": "Company website that was checked."
            },
            "source": {
                "type": "string",
                "title": "ATS source",
                "description": "Which public board had jobs: greenhouse, lever, or ashby. Empty when none matched."
            },
            "boardToken": {
                "type": "string",
                "title": "Board",
                "description": "Job board name that matched. Empty when none matched."
            },
            "totalRoles": {
                "type": "integer",
                "title": "Open roles",
                "description": "Open jobs on the board. Zero when no board was found."
            },
            "matchedRoles": {
                "type": "integer",
                "title": "Matched roles",
                "description": "Open jobs in the functions you are tracking."
            },
            "functionBreakdown": {
                "type": "object",
                "title": "Function breakdown",
                "description": "How many matched jobs fall in each tracked function.",
                "additionalProperties": {
                    "type": "integer"
                }
            },
            "isBaseline": {
                "type": "boolean",
                "title": "First check",
                "description": "True the first time this company is checked. Open jobs are not counted as new until a later run."
            },
            "newRoleIds": {
                "type": "array",
                "title": "New role IDs",
                "description": "Matched job IDs that were not open on the previous run. Empty on the first check.",
                "items": {
                    "type": "string"
                }
            },
            "removedRoleIds": {
                "type": "array",
                "title": "Removed role IDs",
                "description": "Matched job IDs from the previous run that are no longer open. Empty on the first check.",
                "items": {
                    "type": "string"
                }
            },
            "newRolesCount": {
                "type": "integer",
                "title": "New roles",
                "description": "How many matched job IDs are new since the previous run."
            },
            "removedRolesCount": {
                "type": "integer",
                "title": "Removed roles",
                "description": "How many previously matched job IDs are no longer open."
            },
            "newRolesByFunction": {
                "type": "object",
                "title": "New roles by function",
                "description": "New matched job IDs grouped by function.",
                "additionalProperties": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "signalScore": {
                "type": "number",
                "title": "Signal score",
                "description": "How strong the hiring signal is. New jobs count more than jobs that were already open."
            },
            "meetsThreshold": {
                "type": "boolean",
                "title": "Meets threshold",
                "description": "True when the signal score is at least your threshold."
            },
            "signalThreshold": {
                "type": "integer",
                "title": "Threshold",
                "description": "Signal threshold used for this run."
            },
            "verifiedContact": {
                "type": "string",
                "title": "Verified contact",
                "description": "Department email that checked as valid, or as risky when the domain accepts every address. Empty when none worked or the check was skipped."
            },
            "contactStatus": {
                "type": "string",
                "title": "Contact status",
                "description": "valid, risky, not_found, unknown, or skipped."
            },
            "contactSource": {
                "type": "string",
                "title": "Contact source",
                "description": "Which address was used: careers, jobs, recruiting, or hr. Empty when none."
            },
            "matchedTitles": {
                "type": "array",
                "title": "Matched titles",
                "description": "Open jobs that matched a tracked function, with the job title, function, and job ID.",
                "items": {
                    "type": "object",
                    "properties": {
                        "title": {
                            "type": "string",
                            "title": "Title"
                        },
                        "function": {
                            "type": "string",
                            "title": "Function"
                        },
                        "id": {
                            "type": ["string", "null"],
                            "title": "Job ID"
                        }
                    }
                }
            }
        }
    },
    "views": {
        "overview": {
            "title": "Hiring signals",
            "description": "One row per company.",
            "transformation": {
                "fields": [
                    "name",
                    "domain",
                    "source",
                    "totalRoles",
                    "functionBreakdown",
                    "newRoleIds",
                    "removedRoleIds",
                    "signalScore",
                    "meetsThreshold",
                    "verifiedContact",
                    "contactStatus",
                    "contactSource",
                    "matchedRoles",
                    "newRolesCount",
                    "removedRolesCount",
                    "isBaseline",
                    "boardToken",
                    "signalThreshold",
                    "newRolesByFunction",
                    "matchedTitles"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "name": {
                        "label": "Company",
                        "format": "text"
                    },
                    "domain": {
                        "label": "Domain",
                        "format": "text"
                    },
                    "source": {
                        "label": "ATS source",
                        "format": "text"
                    },
                    "totalRoles": {
                        "label": "Open roles",
                        "format": "number"
                    },
                    "functionBreakdown": {
                        "label": "Function breakdown",
                        "format": "object"
                    },
                    "newRoleIds": {
                        "label": "New role IDs",
                        "format": "array"
                    },
                    "removedRoleIds": {
                        "label": "Removed role IDs",
                        "format": "array"
                    },
                    "signalScore": {
                        "label": "Signal score",
                        "format": "number"
                    },
                    "meetsThreshold": {
                        "label": "Meets threshold",
                        "format": "boolean"
                    },
                    "verifiedContact": {
                        "label": "Verified contact",
                        "format": "text"
                    },
                    "contactStatus": {
                        "label": "Contact status",
                        "format": "text"
                    },
                    "contactSource": {
                        "label": "Contact source",
                        "format": "text"
                    },
                    "matchedRoles": {
                        "label": "Matched roles",
                        "format": "number"
                    },
                    "newRolesCount": {
                        "label": "New roles",
                        "format": "number"
                    },
                    "removedRolesCount": {
                        "label": "Removed roles",
                        "format": "number"
                    },
                    "isBaseline": {
                        "label": "First check",
                        "format": "boolean"
                    },
                    "boardToken": {
                        "label": "Board",
                        "format": "text"
                    },
                    "signalThreshold": {
                        "label": "Threshold",
                        "format": "number"
                    },
                    "newRolesByFunction": {
                        "label": "New roles by function",
                        "format": "object"
                    },
                    "matchedTitles": {
                        "label": "Matched titles",
                        "format": "array"
                    }
                }
            }
        }
    }
}
